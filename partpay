import sys

wage = 1400
total = 0

for line in sys.stdin:
    times = line.strip().split()

    start = times[0].split(":")
    end = times[1].split(":")

    start_min = int(start[0]) * 60 + int(start[1])
    end_min = int(end[0]) * 60 + int(end[1])

    span = end_min - start_min

    if span <= 6 * 60:
        rest = 0
    elif span <= 8 * 60 + 45:
        rest = 45
    else:
        rest = 60

    work_min = span - rest

    if work_min > 8 * 60:
        normal_min = 8 * 60
        overtime_min = work_min - 8 * 60
    else:
        normal_min = work_min
        overtime_min = 0

    pay = normal_min / 60 * wage
    pay += overtime_min / 60 * wage * 1.25

    total += pay

print(int(total))
