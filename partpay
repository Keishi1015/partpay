import sys

wage = 1400
total = 0

for line in sys.stdin:
    times = line.strip().split()

    start = times[0].split(":")
    end = times[1].split(":")

    start_min = int(start[0]) * 60 + int(start[1])
    end_min = int(end[0]) * 60 + int(end[1])

    work_min = end_min - start_min
    pay = work_min / 60 * wage

    total += pay

print(int(total))
