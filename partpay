import sys

wage = 1400
total = 0

for line in sys.stdin:
    times = line.strip().split()

    start = times[0].split(":")
    end = times[1].split(":")

    start_min = int(start[0]) * 60 + int(start[1])
    end_min = int(end[0]) * 60 + int(end[1])

    span = end_min - start_min

    if span <= 6 * 60:
        rest = 0
    elif span <= 8 * 60 + 45:
        rest = 45
    else:
        rest = 60

    work_min = span - rest
    pay = work_min / 60 * wage

    total += pay

print(int(total))
