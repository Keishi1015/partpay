import argparse
import sys


def error(message):
    print(message, file=sys.stderr)
    sys.exit(1)


def positive_int(text):
    try:
        value = int(text)
    except ValueError:
        raise argparse.ArgumentTypeError("時給は整数で指定してください")

    if value <= 0:
        raise argparse.ArgumentTypeError("時給は正の整数で指定してください")

    return value


def parse_args():
    parser = argparse.ArgumentParser(
        prog="partpay",
        description="標準入力から勤務の開始・終了時刻と休憩時間を読み、給料を計算します。"
    )

    parser.add_argument(
        "-w", "--wage",
        type=positive_int,
        default=1400,
        help="時給（円、正の整数）。既定値は1400"
    )

    parser.add_argument(
        "-t", "--total",
        action="store_true",
        help="1日ごとの給料ではなく、全日の合計を出力する"
    )

    return parser.parse_args()


def to_minutes(time):
    parts = time.split(":")

    if len(parts) != 2:
        error("時刻の形式が正しくありません")

    try:
        hour = int(parts[0])
        minute = int(parts[1])
    except ValueError:
        error("時刻は数値で入力してください")

    if hour < 0 or hour > 24:
        error("時間の範囲が正しくありません")

    if minute < 0 or minute >= 60:
        error("分の範囲が正しくありません")

    if hour == 24 and minute != 0:
        error("24時を超えています")

    return hour * 60 + minute


def default_break(span):
    if span <= 6 * 60:
        return 0
    elif span <= 8 * 60 + 45:
        return 45
    else:
        return 60


def required_break(work_min):
    if work_min <= 6 * 60:
        return 0
    elif work_min <= 8 * 60:
        return 45
    else:
        return 60


def is_night(minute):
    minute = minute % (24 * 60)
    return minute >= 22 * 60 or minute < 5 * 60


def count_minutes(start, end, rest):
    daytime = []
    nighttime = []

    for m in range(start, end):
        if is_night(m):
            nighttime.append(m)
        else:
            daytime.append(m)

    order = daytime + nighttime
    resting = order[:rest]

    normal = 0
    single = 0
    double = 0
    worked = 0

    for m in range(start, end):
        if m in resting:
            continue

        overtime = worked >= 8 * 60
        night = is_night(m)

        if overtime and night:
            double += 1
        elif overtime or night:
            single += 1
        else:
            normal += 1

        worked += 1

    return normal, single, double


args = parse_args()
wage = args.wage
pays = []
lineno = 0

for line in sys.stdin:
    lineno += 1

    if line.strip() == "":
        continue

    times = line.strip().split()

    if len(times) != 2 and len(times) != 3:
        error("開始時刻 終了時刻 [休憩時間] の形式で入力してください")

    start_min = to_minutes(times[0])
    end_min = to_minutes(times[1])

    if start_min == 24 * 60:
        error("開始時刻は24時未満にしてください")

    if end_min < start_min:
        end_min += 24 * 60

    span = end_min - start_min

    if len(times) == 3:
        if not (times[2].isascii() and times[2].isdigit()):
            error("休憩は0以上の整数（分）で指定してください")

        rest = int(times[2])
    else:
        rest = default_break(span)

    if rest >= span:
        error("休憩が拘束時間以上です")

    work_min = span - rest
    required = required_break(work_min)

    if rest < required:
        print(
            f"警告: {lineno}行目: 休憩{rest}分は法定の最低{required}分より短いです",
            file=sys.stderr
        )

    normal, single, double = count_minutes(
        start_min, end_min, rest
    )

    pay = normal * wage / 60
    pay += single * wage * 1.25 / 60
    pay += double * wage * 1.5 / 60

    pays.append(pay)

if len(pays) == 0:
    error("入力がありません")

if args.total:
    print(int(sum(pays)))
else:
    for pay in pays:
        print(int(pay))
