import sys

wage = 1400
total = 0


def error(message):
    print(message, file=sys.stderr)
    sys.exit(1)


def to_minutes(time):
    parts = time.split(":")

    if len(parts) != 2:
        error("時刻の形式が正しくありません")

    try:
        hour = int(parts[0])
        minute = int(parts[1])
    except ValueError:
        error("時刻は数値で入力してください")

    if hour < 0 or hour > 24:
        error("時間の範囲が正しくありません")

    if minute < 0 or minute >= 60:
        error("分の範囲が正しくありません")

    if hour == 24 and minute != 0:
        error("24時を超えています")

    return hour * 60 + minute


def is_night(minute):
    minute = minute % (24 * 60)
    return minute >= 22 * 60 or minute < 5 * 60


def count_minutes(start, end, rest):
    daytime = []
    nighttime = []

    for m in range(start, end):
        if is_night(m):
            nighttime.append(m)
        else:
            daytime.append(m)

    order = daytime + nighttime
    resting = order[:rest]

    normal = 0
    single = 0
    double = 0
    worked = 0

    for m in range(start, end):
        if m in resting:
            continue

        overtime = worked >= 8 * 60
        night = is_night(m)

        if overtime and night:
            double += 1
        elif overtime or night:
            single += 1
        else:
            normal += 1

        worked += 1

    return normal, single, double


for line in sys.stdin:
    times = line.strip().split()

    if len(times) != 2:
        error("開始時刻と終了時刻を入力してください")

    start_min = to_minutes(times[0])
    end_min = to_minutes(times[1])

    if start_min == 24 * 60:
        error("開始時刻は24時未満にしてください")

    if end_min < start_min:
        end_min += 24 * 60

    span = end_min - start_min

    if span <= 6 * 60:
        rest = 0
    elif span <= 8 * 60 + 45:
        rest = 45
    else:
        rest = 60

    normal, single, double = count_minutes(
        start_min, end_min, rest
    )

    pay = normal / 60 * wage
    pay += single / 60 * wage * 1.25
    pay += double / 60 * wage * 1.5

    total += pay

print(int(total))
