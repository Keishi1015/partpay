import sys

wage = 1400
total = 0

def is_night(minute):
    return minute >= 22 * 60 or minute < 5 * 60


def count_minutes(start, end, rest):
    daytime = []
    nighttime = []

    for m in range(start, end):
        if is_night(m):
            nighttime.append(m)
        else:
            daytime.append(m)

    order = daytime + nighttime
    resting = order[:rest]

    normal = 0
    single = 0
    double = 0
    worked = 0

    for m in range(start, end):
        if m in resting:
            continue

        overtime = worked >= 8 * 60
        night = is_night(m)

        if overtime and night:
            double += 1
        elif overtime or night:
            single += 1
        else:
            normal += 1

        worked += 1

    return normal, single, double


for line in sys.stdin:
    times = line.strip().split()

    start = times[0].split(":")
    end = times[1].split(":")

    start_min = int(start[0]) * 60 + int(start[1])
    end_min = int(end[0]) * 60 + int(end[1])

    span = end_min - start_min

    if span <= 6 * 60:
        rest = 0
    elif span <= 8 * 60 + 45:
        rest = 45
    else:
        rest = 60

    normal, single, double = count_minutes(
        start_min, end_min, rest
    )

    pay = normal / 60 * wage
    pay += single / 60 * wage * 1.25
    pay += double / 60 * wage * 1.5

    total += pay

print(int(total))
